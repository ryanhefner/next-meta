# Only resolve package versions published at least two weeks ago.
min-release-age=14

# Security patch for GHSA-gfhx-hw2g-v5hg, pinned by package.json.
# Remove after 2026-10-07 when 7.1.2 meets the two-week release age.
min-release-age-exclude[]=serialize-javascript

# Patched development-only Next.js fixture for GHSA-vcvr-r3jv-pc5j.
# Remove after 2026-10-06 when the pinned 16.3.6 patch meets the policy.
min-release-age-exclude[]=next
min-release-age-exclude[]=@next/*
