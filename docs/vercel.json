{
  "framework": "nextjs",
  "installCommand": "cd .. && corepack enable && pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "cd .. && pnpm run docs:build",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/markdown/:path*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
